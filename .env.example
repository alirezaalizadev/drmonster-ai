# =============================================================================
# Environment variables — NAMES ONLY. Copy the ones you need into Railway's
# "Variables" tab (do NOT commit real values). Leave PORT alone (Railway sets it).
# =============================================================================

# ---- Railway web service (the app itself) ----
# Your Supabase Project URL. Supabase → Project Settings → API → "Project URL".
SUPABASE_URL=

# Your Supabase anon / public key (browser-safe, protected by Row Level Security).
# Supabase → Project Settings → API → "Project API keys" → anon public.
SUPABASE_ANON_KEY=

# PORT is provided automatically by Railway — do NOT set it yourself.

# ---- Supabase Edge Functions (set in SUPABASE, not Railway) ----
# These are configured with the Supabase CLI, e.g.:
#   supabase secrets set ANTHROPIC_API_KEY=...
# and are NOT added to Railway.
# ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=
